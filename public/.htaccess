# Apache configuration for the public web root
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS (uncomment once SSL is active on your host)
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Send everything that is not an existing file to the front controller
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  # Versioned build assets (?v=…) and mirrored stock photos never change: cache for a year
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/(stock|icons|fonts)/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Uploaded media and other images: 30 days
  <FilesMatch "\.(svg|png|jpe?g|webp|avif|gif|ico)$">
    Header setifempty Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Uncomment once HTTPS works on every subdomain:
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/rss+xml application/manifest+json image/svg+xml image/x-icon
</IfModule>

# Block hidden files (.env, .git …)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
